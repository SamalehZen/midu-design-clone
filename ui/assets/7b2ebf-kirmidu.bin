    const formatters = {"formatFullTimestamp": (function formatFullTimestamp({ timestamp, lang, timeZone }) {
	const date = new Date(timestamp);
	return `${date.toLocaleTimeString(lang, {
		hour: "numeric",
		minute: "2-digit",
		timeZone
	})} · ${date.toLocaleDateString(lang, {
		month: "short",
		day: "numeric",
		year: "numeric",
		timeZone
	})}`;
}),
"formatLongDate": (function formatLongDate({ timestamp, lang, timeZone }) {
	return new Date(timestamp).toLocaleDateString(lang, {
		dateStyle: "long",
		timeZone
	});
}),
